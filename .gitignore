# 密钥：绝对不许提交
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 数据与向量库（体积大，第 2 周会用到）
# ⚠️ 用 data/* 而不是 data/ —— 因为 Git 规定"父目录被整体排除时，无法再单独放行里面的文件"。
#    语料清单 data/corpus.json 必须进 git：它是"评测可复现"的凭证（语料快照）。
data/*
!data/corpus.json
# 评测集是手写资产、manifest 是数据状态凭证 —— 两者必须进 git，否则换机器就没了
!data/eval/
data/eval/*
!data/eval/dataset.jsonl
!data/manifest.json
*.sqlite3
chroma/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

#日志：绝对不许提交
logs/
log/
*.log
*.log.gz

# 测试 / 工具缓存
.pytest_cache/
.ruff_cache/

# 草稿:不提交
scratch/

# 教学回合的运行时状态（每次会话生成，含会话号，不该进仓库）
.claude/hooks/state/

# 临时放行开关：写它等于当场关掉闸门，绝不能进仓库
.claude/hooks/GUARD-OFF
.claude/hooks/MODE



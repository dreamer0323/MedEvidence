# 复制成 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 变量名与 src/config.py 一一对应，改这里就要改那里。

# ---------- LLM（DeepSeek）----------
LLM_API_KEY=sk-your-key-here
LLM_MODEL_NAME=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek

# ---------- Embedding（SiliconFlow / BGE-M3）----------
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_PROVIDER=siliconflow
# 单次请求塞几条文本，留空用 src/config.py 里的默认值 16
EMBEDDING_BATCH_SIZE=

# ---------- NCBI E-utilities（第 2 周抓 PMC 全文用）----------
# 官方要求标识调用方。不填也能抓，但被限流时没有申诉依据。
# 留空 → 3 req/s；填了 API key → 10 req/s（抓取脚本的 sleep 由这里推导）
NCBI_EMAIL=
NCBI_API_KEY=

# ---------- Rerank（第 6 周才用，现在留空）----------
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
